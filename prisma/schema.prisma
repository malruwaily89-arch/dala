// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// الصالون (المستأجر)
model Tenant {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique // رابط الحجز العام: /b/{slug}
  phone       String
  city        String? // المدينة: الرياض / جدة / الدمام ...
  plan        String    @default("trial") // trial | basic | pro | advanced | basic_pro | pro_pro | advanced_pro
  planExpires DateTime?
  bankName    String? // حساب تحويل العربون
  bankIban    String?
  whatsappNumber String?
  logoUrl     String? // شعار الصالون (علامته التجارية)
  brandColor  String  @default("#be185d") // لونه المميز
  createdAt   DateTime  @default(now())

  users        User[]
  services     Service[]
  staff        Staff[]
  customers    Customer[]
  appointments Appointment[]
  waitlist     Waitlist[]
  messageLogs  MessageLog[]
  subscriptions Subscription[]
  payments     Payment[]
  ratings      Rating[]

  @@map("tenants")
}

// مستخدم لوحة التحكم (مالك الصالون أو مدير المنصة)
model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OWNER") // OWNER | SUPER_ADMIN
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("users")
}

// جلسة تسجيل الدخول
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// الخدمة
model Service {
  id              String  @id @default(cuid())
  tenantId        String
  name            String
  durationMinutes Int     @default(60)
  price           Float
  depositAmount   Float   @default(0) // العربون المطلوب
  isActive        Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

// الموظفة
model Staff {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  phone        String?
  workingHours String  @default("{\"start\":\"09:00\",\"end\":\"21:00\",\"days\":[0,1,2,3,4,6]}")
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("staff")
}

// العميلة
model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  notes       String?
  noShowCount Int      @default(0) // عداد عدم الحضور (قائمة سوداء ناعمة)
  createdAt   DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  waitlist     Waitlist[]
  ratings      Rating[]

  @@unique([tenantId, phone])
  @@map("customers")
}

// الموعد (القلب النابض)
model Appointment {
  id             String    @id @default(cuid())
  tenantId       String
  bookingCode    String    @unique // رقم الحجز للعرض: SY-XXXXXX
  customerId     String
  staffId        String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  status         String    @default("pending_deposit") // pending_deposit | confirmed | done | no_show | cancelled
  depositAmount  Float     @default(0)
  depositPaidAt  DateTime?
  paymentMethod  String? // gateway | manual_transfer
  paymentRef     String? // رقم عملية الدفع من بوابة الدفع (مطابقة تلقائية)
  createdVia     String    @default("dashboard") // whatsapp | link | dashboard
  reminderSentAt DateTime?
  rescheduledAt  DateTime? // آخر مرة تم فيها تعديل موعد الحجز (تغيير التاريخ/الوقت)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messageLogs    MessageLog[]
  rating         Rating?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@index([tenantId, startsAt])
  @@index([status])
  @@map("appointments")
}

// تقييم الزبونة للخدمة بعد إتمامها
model Rating {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  tenantId      String
  customerId    String
  score         Int // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ratings")
}

// قائمة الانتظار
model Waitlist {
  id              String    @id @default(cuid())
  tenantId        String
  customerId      String
  serviceId       String?
  preferredWindow String? // مثال: "مساءً" أو نطاق زمني
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("waitlist")
}

// سجل الرسائل (واتساب)
model MessageLog {
  id            String    @id @default(cuid())
  tenantId      String
  appointmentId String?
  direction     String // out | in
  waMessageId   String? // idempotency ضد الإرسال المكرر
  templateName  String?
  payload       String?
  status        String    @default("queued") // queued | sent | delivered | failed
  sentAt        DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("message_logs")
}

// اشتراك الصالون
model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  plan               String // BASIC | PRO | ADVANCED | BASIC_PRO | PRO_PRO | ADVANCED_PRO
  status             String    @default("trialing") // trialing | active | past_due | suspended | canceled
  startedAt          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

// دفعة من الصالون
model Payment {
  id             String    @id @default(cuid())
  tenantId       String
  subscriptionId String?
  amount         Float
  currency       String    @default("SAR")
  status         String    @default("pending") // pending | paid | failed | refunded
  provider       String    @default("moyasar") // moyasar
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}
