# مفتاح Claude من platform.claude.com
ANTHROPIC_API_KEY=

# النموذج الأساسي. المساعد يطلب موافقتك قبل ما يستخدم Sonnet أو Opus لمهمة أصعب.
AGENT_MODEL=claude-haiku-5-5

# سقف المصروف الشهري التقديري بالريال: تنبيه عند 70% و90%، وإيقاف الطلبات عند بلوغه
MONTHLY_BUDGET_SAR=300

# رقم المساعد في WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# رقمك الشخصي بالصيغة الدولية (مثال: 9665XXXXXXXX). أي رقم غيره يتجاهله المساعد.
OWNER_WHATSAPP_NUMBER=

# المتصفح: يفتح مواقع في ملف منفصل، ويطلب موافقتك قبل أي إرسال أو بيانات شخصية
BROWSER_ENABLED=true

# مجلد ملفاتك على السيرفر
FILES_HOST_DIR=/home/mohammedalruwaily89/assistant-files

# صاحب الملفات على السيرفر (ناتج الأمرين id -u و id -g)
HOST_UID=1000
HOST_GID=1000
