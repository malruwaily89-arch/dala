# ─── قاعدة البيانات (PostgreSQL) ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mutrafa?schema=public"

# ─── الموقع ───
APP_URL="http://localhost:3000"

# ─── وضع الدفع ───
# sandbox: صفحة دفع تجريبية داخل الموقع (لا تُحصّل أي مبلغ) — الافتراضي
# moyasar: بوابة Moyasar الحقيقية (تتطلب المفاتيح أدناه)
PAYMENT_MODE="sandbox"
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ─── واتساب (Meta Cloud API) ───
# بدون هذه المفاتيح تُسجَّل الرسائل كمحاكاة (simulated) ولا تُرسل فعلياً
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="mutrafa-verify-token"
WHATSAPP_API_VERSION="v21.0"

# ─── المهام المجدولة (التذكيرات وانتهاء مهلة العربون) ───
CRON_SECRET="change-me-long-random-string"
